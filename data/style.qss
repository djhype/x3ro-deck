/* Widget chrome around the QML panels and embedded terminals. */

QMainWindow, #central, QSplitter, QStackedWidget {
    background: ${bg0};
}

QSplitter::handle {
    background: ${line};
}
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }
QSplitter::handle:hover { background: ${magenta}; }

#shellStack, #agentStack {
    background: ${well};
}

#terminalFrame {
    background: ${well};
    border: 1px solid ${line};
    border-radius: 0px;
}
#terminalFrame[accent="attention"] {
    border: 1px solid ${amber};
}

#terminalPlaceholder {
    color: ${pink};
    font-size: 13px;
    padding: 24px;
}

QTabWidget#shellTabs::pane {
    border: none;
    background: ${well};
}
QTabWidget#shellTabs QTabBar {
    background: ${bg1};
    qproperty-drawBase: 0;
}
QTabWidget#shellTabs QTabBar::tab {
    background: transparent;
    color: ${dim};
    font-family: "${font.mono}";
    font-size: 12px;
    padding: 7px 14px;
    margin: 4px 2px 4px 0;
    border-radius: 7px;
    border: none;
}
QTabWidget#shellTabs QTabBar::tab:selected {
    background: ${rowLine};
    color: ${text};
}
QTabWidget#shellTabs QTabBar::tab:hover:!selected {
    background: ${raised};
}
QTabWidget#shellTabs QTabBar::close-button {
    subcontrol-position: right;
    image: url(${icon:close});
    margin-left: 6px;
}
QTabWidget#shellTabs QTabBar::close-button:hover {
    image: url(${icon:close-hover});
}

QToolButton#newTab {
    background: transparent;
    color: ${dim};
    border: none;
    border-radius: 7px;
    font-size: 16px;
    min-width: 32px;
    min-height: 28px;
    margin: 4px 8px;
}
QToolButton#newTab:hover {
    background: ${rowLine};
    color: ${magenta};
}

/* Settings and message boxes, in the QML panels' palette. Scoped by class so
   the Konsole parts and the system file dialog keep their own look. */

DeckDialog, QMessageBox {
    background: ${bg1};
}
DeckDialog QLabel, QMessageBox QLabel {
    color: ${soft};
    font-family: "${font.sans}";
    font-size: 13px;
}
DeckDialog QLabel#hint {
    color: ${dim};
    font-size: 12px;
}
DeckDialog QLabel#warning {
    color: ${amber};
    font-size: 12px;
}
DeckDialog QLabel#section {
    color: ${dim};
    font-size: 11px;
    font-weight: 600;
    padding-top: 6px;
}

DeckDialog QLineEdit, DeckDialog QPlainTextEdit, DeckDialog QComboBox {
    background: ${bg0};
    color: ${text};
    border: 1px solid ${line};
    border-radius: 7px;
    padding: 6px 9px;
    font-family: "${font.sans}";
    font-size: 13px;
    selection-background-color: ${magenta};
    selection-color: ${ink};
}
DeckDialog QLineEdit[mono="true"], DeckDialog QPlainTextEdit[mono="true"] {
    font-family: "${font.mono}";
    font-size: 12px;
}
DeckDialog QLineEdit:focus, DeckDialog QPlainTextEdit:focus, DeckDialog QComboBox:focus {
    border-color: ${magenta};
}
DeckDialog QLineEdit:disabled, DeckDialog QPlainTextEdit:disabled, DeckDialog QComboBox:disabled {
    color: ${muted};
    border-color: ${rowLine};
}
DeckDialog QComboBox QLineEdit {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
}
DeckDialog QComboBox::drop-down {
    border: none;
    width: 26px;
}
DeckDialog QComboBox::down-arrow {
    image: url(${icon:chevron-down});
    width: 12px;
    height: 12px;
}
DeckDialog QComboBox QAbstractItemView {
    background: ${panel};
    color: ${text};
    border: 1px solid ${line2};
    padding: 4px;
    outline: none;
    selection-background-color: ${selected};
    selection-color: ${magenta};
}

DeckDialog QPushButton, QMessageBox QPushButton {
    background: ${raised};
    color: ${text};
    border: 1px solid ${line};
    border-radius: 9px;
    padding: 8px 16px;
    font-family: "${font.sans}";
    font-size: 13px;
}
DeckDialog QPushButton:hover, QMessageBox QPushButton:hover {
    background: ${selected};
    border-color: ${line2};
}
DeckDialog QPushButton:default, QMessageBox QPushButton:default {
    background: ${magenta/0.08};
    color: ${magenta};
    border-color: ${magenta};
    font-weight: 600;
}
DeckDialog QPushButton:default:hover, QMessageBox QPushButton:default:hover {
    background: ${magenta/0.18};
}
DeckDialog QPushButton:disabled {
    color: ${faint};
    border-color: ${rowLine};
}
DeckDialog QPushButton#small {
    padding: 5px 12px;
    border-radius: 7px;
    font-size: 12px;
}

DeckDialog QListWidget, DeckDialog QTableWidget {
    background: ${panel};
    color: ${text};
    border: 1px solid ${line};
    border-radius: 10px;
    outline: none;
    font-family: "${font.sans}";
    font-size: 13px;
}
DeckDialog QListWidget {
    padding: 4px;
}
DeckDialog QListWidget::item {
    padding: 8px 10px;
    border-radius: 7px;
}
DeckDialog QListWidget::item:selected {
    background: ${selected};
    color: ${magenta};
}
DeckDialog QListWidget::item:hover:!selected {
    background: ${raised};
}
DeckDialog QTableWidget {
    font-family: "${font.mono}";
    font-size: 12px;
}
DeckDialog QTableWidget::item {
    padding: 0 8px;
}
DeckDialog QTableWidget::item:selected {
    background: ${selected};
    color: ${text};
}
DeckDialog QTableWidget QLineEdit {
    border-radius: 0;
    padding: 0 6px;
    font-family: "${font.mono}";
    font-size: 12px;
}
DeckDialog QTableWidget QComboBox {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0 8px;
    font-size: 12px;
}
DeckDialog QHeaderView::section {
    background: ${bg1};
    color: ${dim};
    border: none;
    border-bottom: 1px solid ${line};
    padding: 6px 8px;
    font-family: "${font.sans}";
    font-size: 11px;
}
DeckDialog QTableCornerButton::section {
    background: ${bg1};
    border: none;
}

DeckDialog QCheckBox, DeckDialog QRadioButton {
    color: ${text};
    font-family: "${font.sans}";
    font-size: 13px;
    spacing: 10px;
}
DeckDialog QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid ${line2};
    border-radius: 4px;
    background: ${bg0};
}
DeckDialog QCheckBox::indicator:checked {
    background: ${magenta};
    border-color: ${magenta};
    image: url(${icon:check});
}

DeckDialog QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid ${line2};
    border-radius: 8px;
    background: ${bg0};
}
DeckDialog QRadioButton::indicator:checked {
    width: 8px;
    height: 8px;
    border: 4px solid ${magenta};
}
DeckDialog QCheckBox:disabled, DeckDialog QRadioButton:disabled {
    color: ${muted};
}

DeckDialog QScrollArea, DeckDialog #scrollContent {
    background: transparent;
    border: none;
}
DeckDialog QScrollBar:vertical {
    background: transparent;
    width: 10px;
}
DeckDialog QScrollBar::handle:vertical {
    background: ${line2};
    border-radius: 4px;
    min-height: 30px;
    margin: 2px;
}
DeckDialog QScrollBar::add-line, DeckDialog QScrollBar::sub-line,
DeckDialog QScrollBar::add-page, DeckDialog QScrollBar::sub-page {
    background: none;
    height: 0;
}

QTabWidget#settingsTabs::pane {
    border: none;
    border-top: 1px solid ${line};
}
QTabWidget#settingsTabs QTabBar {
    qproperty-drawBase: 0;
}
QTabWidget#settingsTabs QTabBar::tab {
    background: transparent;
    color: ${dim};
    font-family: "${font.sans}";
    font-size: 13px;
    font-weight: 600;
    padding: 8px 18px;
    margin: 10px 2px 8px 0;
    border-radius: 8px;
    border: none;
}
QTabWidget#settingsTabs QTabBar::tab:first {
    margin-left: 16px;
}
QTabWidget#settingsTabs QTabBar::tab:selected {
    background: ${tabActive};
    color: ${magenta};
}
QTabWidget#settingsTabs QTabBar::tab:hover:!selected {
    background: ${selected};
}
QTabWidget#checkoutTabs::pane {
    border: none;
    border-top: 1px solid ${line};
}
QTabWidget#checkoutTabs QTabBar {
    qproperty-drawBase: 0;
}
QTabWidget#checkoutTabs QTabBar::tab {
    background: transparent;
    color: ${dim};
    font-family: "${font.sans}";
    font-size: 12px;
    font-weight: 600;
    padding: 6px 14px;
    margin: 0 2px 8px 0;
    border-radius: 7px;
    border: none;
}
QTabWidget#checkoutTabs QTabBar::tab:selected {
    background: ${tabActive};
    color: ${magenta};
}
QTabWidget#checkoutTabs QTabBar::tab:hover:!selected {
    background: ${selected};
}
DeckDialog QLabel#title {
    color: ${text};
    font-family: "${font.display}";
    font-size: 24px;
    font-weight: 600;
}
