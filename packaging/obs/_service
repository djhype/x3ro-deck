<services>
  <!-- The release workflow moves the `release` branch to each new tag; the
       version comes from that tag (v1.2.3 -> 1.2.3) and set_version writes it
       into the spec and the PKGBUILD (OBS builds Arch from the PKGBUILD). -->
  <service name="obs_scm">
    <param name="scm">git</param>
    <param name="url">https://github.com/djhype/x3ro-deck.git</param>
    <param name="revision">release</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="versionrewrite-pattern">v(.*)</param>
    <param name="filename">x3ro-deck</param>
  </service>
  <service name="set_version" mode="buildtime"/>
  <service name="tar" mode="buildtime"/>
  <service name="recompress" mode="buildtime">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
  <service name="extract_file">
    <param name="archive">*.tar</param>
    <param name="files">*/packaging/rpm/x3ro-deck.spec */packaging/arch/x3ro-deck/PKGBUILD</param>
  </service>
</services>
