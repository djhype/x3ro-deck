<services>
  <service name="obs_scm">
    <param name="scm">git</param>
    <param name="url">https://github.com/x3ro/x3ro-deck.git</param>
    <param name="revision">v0.1.0</param>
    <param name="versionformat">0.1.0</param>
    <param name="filename">x3ro-deck</param>
  </service>
  <service name="tar" mode="buildtime"/>
  <service name="recompress" mode="buildtime">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
  <service name="extract_file">
    <param name="archive">*.tar</param>
    <param name="files">*/packaging/rpm/x3ro-deck.spec</param>
  </service>
</services>
